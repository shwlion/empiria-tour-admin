# Empiria Tour — Admin console.
# Paste from Supabase → Project Settings → API, for the TOURS project
# (wnaleobzkoukdzlruouu). Never the Empiria-01 project.

# Session auth. Safe to expose: RLS applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. SERVER ONLY, no NEXT_PUBLIC_ prefix, never committed.
# The console reads draft packages, every booking and the audit trail, none of
# which any RLS policy exposes — so it needs this. Without it the app opens but
# refuses to save.
SUPABASE_URL=
SUPABASE_KEY=

# The public storefront, for links out of the console and for previewing
# images stored as root-relative paths. Defaults to the production domain.
# NEXT_PUBLIC_TOUR_URL=http://localhost:3000

# Where an approved partner signs in: the invitation's redirect and the
# "Open the partner console" link in the approval email. Server-only, read at
# request time. Unset, it falls back to https://partners.empiria.events — the
# same default as the storefront's NEXT_PUBLIC_PARTNER_URL — so set it wherever
# the partner console is actually served from, or approvals link elsewhere.
# PARTNER_URL=http://localhost:3002
